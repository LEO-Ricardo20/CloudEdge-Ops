# All settings are optional. The defaults run the local Node-only MVP.

# Server
PORT=4173
STATE_FILE=./data/platform-state.json
OFFLINE_AFTER_MS=15000
OFFLINE_CHECK_INTERVAL_MS=5000
COMMAND_TTL_MS=86400000
# demo or protected; invalid modes fail startup.
AUTH_MODE=demo
# Required together when AUTH_MODE=protected. Use unique local values.
# OPERATOR_TOKEN=replace-with-your-operator-token
# DEVICE_TOKENS={"robot-arm-01":"replace-with-your-device-token"}

# Device simulator
CLOUDEDGE_API=http://127.0.0.1:4173
DEVICE_ID=robot-arm-01
SIMULATOR_INTERVAL_MS=1200
# DEVICE_TOKEN=replace-with-your-device-token
# FIRMWARE_VERSION=0.1.0

# .env files are NOT automatically loaded. Set PowerShell environment variables,
# or use Node 22+: node --env-file=.env server/index.js

# Reserved examples for the formal architecture; not used by the MVP.
# DATABASE_URL=postgres://cloudedge:change-me@localhost:5432/cloudedge
# MQTT_BROKER_URL=mqtts://broker.example.com:8883
